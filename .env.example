FOSSA_API_TOKEN=
FOSSA_BASE_URL=https://app.fossa.com/api
FOSSA_TIMEOUT_SECONDS=20
FOSSA_VERIFY_TLS=true
FOSSA_MAX_PAGE_SIZE=100
FOSSA_REPORT_MAX_CHARS=200000
FOSSA_LOG_LEVEL=INFO
FOSSA_HTTP_HOST=127.0.0.1
FOSSA_HTTP_PORT=8000
# Security policy enforcement (see DECISIONS.md sections 5 and 6)
# Path to the local, tighten-only policy overlay. Optional.
FOSSA_POLICY_FILE=
# Required only to read organization-level security defaults.
FOSSA_ORG_ID=
# Must be true before any tool is allowed to modify FOSSA state. Keep it false
# unless this instance is meant to change policy assignments.
FOSSA_ALLOW_WRITES=false
